APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sweepline
DB_USER=sweepline
DB_PASSWORD=replace-me

APP_COOKIE_SECURE=0
# Defaults: HTTPS provider, 5 GB database budget. Set secure cookies to 1 behind TLS.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
DATA_DATABASE_BUDGET_MB=5120

# BeamNG CPU helpers: auto uses up to 4, leaves one CPU, and obeys memory/cgroup limits.
# Set 1 for serial processing, or an integer 2-16 for a higher/lower per-export limit.
BEAMNG_CPU_WORKERS=auto
